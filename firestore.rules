rules_version = '2';

// =====================================================================
// MODELO DE SEGURIDAD (sin Cloud Functions — todo pasa por estas reglas)
// =====================================================================
// - El TRABAJADOR ficha con un código de 6 dígitos que ELIGE ÉL MISMO (no
//   con su DNI). Ese código nunca se guarda en texto plano: se guarda su
//   huella (hash SHA-256) en "codigos_fichaje/{huella}", que solo sirve
//   para encontrar a qué trabajador pertenece un código al ficharlo, nunca
//   para recuperar el código original — ni el administrador puede verlo.
//   El trabajador establece ese código la primera vez a través de un
//   enlace de invitación por email (que manda el administrador cuando
//   quiere, nunca en automático), y puede cambiarlo cuando quiera desde
//   "he olvidado mi código" — para ambas cosas, Firestore exige que esté
//   autenticado de verdad con Firebase Authentication (con su email real).
// - El ADMINISTRADOR sí inicia sesión de verdad, con Firebase
//   Authentication (email + contraseña). Solo así se puede proteger algo
//   de verdad en una lectura, ya que una lectura no lleva "cuerpo" que
//   las reglas puedan inspeccionar — sin una sesión real no hay forma de
//   comprobar "¿tienes el código de administrador?" al leer.
// - Los datos de cada trabajador viven en SUBCOLECCIONES dentro de su
//   propio documento (trabajadores/{dni}/fichajes, .../incidencias,
//   .../correcciones). Esto permite que un trabajador solo pueda listar
//   SU PROPIA subcolección (hace falta conocer el DNI exacto en la ruta),
//   mientras que el administrador accede a todas a la vez mediante una
//   "collection group query", protegida aparte.
// - Nunca se permite "update" ni "delete" sobre el historial (fichajes,
//   incidencias ya creadas, correcciones) salvo el único caso permitido:
//   un administrador marcando una incidencia como resuelta.
// - El NSS y el email de cada trabajador viven en un documento aparte
//   (trabajadores_privado/{dni}), legible solo por un administrador
//   logueado — así el flujo normal de fichar (que sí necesita leer el
//   nombre del trabajador) nunca expone ese dato más sensible.

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    function trabajadorExiste(dni) {
      return exists(/databases/$(database)/documents/trabajadores/$(dni));
    }

    function trabajadorActivo(dni) {
      return trabajadorExiste(dni) &&
        get(/databases/$(database)/documents/trabajadores/$(dni)).data.activo == true;
    }

    // ---------- TRABAJADORES (datos básicos, no sensibles) ----------
    match /trabajadores/{dni} {
      // Lectura de UN trabajador concreto: hace falta saber su DNI exacto.
      // Ya no se teclea el DNI en el kiosk (ahora se ficha con el código de
      // 6 dígitos, ver "codigos_fichaje" más abajo), pero el propio
      // proceso de fichar necesita este paso internamente, tras resolver
      // el código a un DNI. Listar TODA la plantilla de golpe solo lo
      // puede hacer un administrador logueado.
      allow get: if true;
      allow list: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if false; // nunca se elimina — solo se da de baja (activo:false)
    }

    // ---------- DATOS PRIVADOS DEL TRABAJADOR (NSS, email, cuenta) ----------
    match /trabajadores_privado/{dni} {
      allow get, list: if esAdmin();
      allow create: if esAdmin();
      // El administrador puede editar todo. El propio trabajador, ya
      // autenticado (tras aceptar la invitación o recuperar su código),
      // solo puede tocar dos campos suyos, y nunca puede robar la cuenta
      // de otro: "uid" solo se puede fijar UNA vez, y solo si su email de
      // verdad (verificado por Firebase, no algo que él escriba) coincide
      // con el email que el administrador le puso al darlo de alta.
      allow update: if esAdmin() || (
        request.auth != null &&
        resource.data.email == request.auth.token.email &&
        (
          (!('uid' in resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])) ||
          (resource.data.uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hashCodigoActual']))
        )
      );
      allow delete: if false;
    }

    // ---------- de UID a DNI (para que "Mis registros" sepa quién ha
    // iniciado sesión, sin tener que adivinar ni listar nada) ----------
    match /uid_a_dni/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.dni is string &&
        trabajadorExiste(request.resource.data.dni) &&
        get(/databases/$(database)/documents/trabajadores_privado/$(request.resource.data.dni)).data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ---------- CÓDIGO DE FICHAJE (6 dígitos elegidos por el trabajador) ----------
    // El documento vive en "codigos_fichaje/{huellaDelCodigo}" — la huella
    // (SHA-256) hace de identificador, así nunca se guarda el código en sí.
    // Fichar necesita poder LEER un documento conociendo su huella exacta
    // (igual que antes hacía falta conocer el DNI exacto); nadie puede
    // listar la colección entera salvo un administrador.
    match /codigos_fichaje/{huella} {
      allow get: if true;
      allow list: if esAdmin();
      // Solo el propio trabajador (ya autenticado, con su email verificado
      // por Firebase) puede crear o borrar SU código, y solo si sigue de
      // alta. El administrador también puede borrarlo (lo hace al dar de
      // baja a alguien).
      allow create: if request.auth != null &&
        request.resource.data.dni is string &&
        trabajadorActivo(request.resource.data.dni) &&
        get(/databases/$(database)/documents/trabajadores_privado/$(request.resource.data.dni)).data.uid == request.auth.uid;
      allow delete: if esAdmin() || (
        request.auth != null && resource.data.dni is string &&
        get(/databases/$(database)/documents/trabajadores_privado/$(resource.data.dni)).data.uid == request.auth.uid
      );
      allow update: if false; // para cambiar de código se borra el antiguo y se crea uno nuevo
    }

    // ---------- HORARIO SEMANAL ----------
    match /horarios/{dni} {
      // Necesario en lectura para que el propio navegador del trabajador
      // pueda calcular si su fichaje llega dentro o fuera de horario.
      allow get: if true;
      allow list: if esAdmin();
      allow write: if esAdmin();
    }

    // ---------- ADMINISTRADORES ----------
    // Se crean a mano desde la consola de Firebase (ver README) — nunca
    // desde la propia app.
    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ---------- SELLO DE CADA INFORME DESCARGADO (auditoría, no borrable) ----------
    // Registro independiente del propio PDF/Excel: qué se descargó, cuándo,
    // quién lo pidió, y el código de verificación (huella) de los datos que
    // llevaba en ese momento. Sirve para comprobar después si un documento
    // descargado se ha manipulado (su huella ya no coincidiría con esta).
    match /descargas_certificadas/{id} {
      allow get, list: if esAdmin();
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    // ---------- CALENDARIO LABORAL (festivos, vacaciones, bajas) ----------
    match /calendario/{id} {
      // La lectura ya no es solo para el administrador: el propio
      // trabajador necesita consultar sus festivos/vacaciones/bajas para
      // calcular sus horas pendientes de teletrabajo en "Mis registros"
      // (mismo criterio de "si sabes consultarlo, puedes leerlo" que ya
      // se usa en fichajes/incidencias/correcciones de cada trabajador).
      allow get, list: if true;
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    // ---------- HISTORIAL DE CADA TRABAJADOR (subcolecciones) ----------
    match /trabajadores/{dni} {

      match /fichajes/{id} {
        allow get, list: if true; // hace falta conocer el DNI exacto en la ruta
        allow create: if trabajadorActivo(dni);
        allow update, delete: if false; // el historial nunca se toca
      }

      match /incidencias/{id} {
        allow get, list: if true;
        allow create: if trabajadorExiste(dni);
        // Único "update" permitido en todo el sistema: un administrador
        // logueado marcando una incidencia como resuelta.
        allow update: if esAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['justificada', 'resueltoPor', 'resueltoEl']);
        allow delete: if false;
      }

      match /correcciones/{id} {
        allow get, list: if true;
        // El propio trabajador puede añadir su motivo; un administrador
        // (logueado) puede añadir su corrección certificada.
        allow create: if trabajadorExiste(dni) && (
          request.resource.data.rolSolicitante == 'Trabajador' ||
          (request.resource.data.rolSolicitante == 'Administrador' && esAdmin())
        );
        allow update, delete: if false; // nunca se sobrescribe, solo se añade
      }
    }

    // ---------- ACCESO DE ADMINISTRACIÓN A TODOS LOS TRABAJADORES A LA VEZ ----------
    // "Collection group queries": permiten a un administrador logueado
    // ver, por ejemplo, todos los "incidencias" pendientes de cualquier
    // trabajador de una sola vez (para la lista de pendientes).
    match /{ruta=**}/fichajes/{id} {
      allow list: if esAdmin();
    }
    match /{ruta=**}/incidencias/{id} {
      allow list: if esAdmin();
    }
    match /{ruta=**}/correcciones/{id} {
      allow list: if esAdmin();
    }
  }
}
